{
  "name": "screen-studio-bridge", "version": "0.1.0", "private": true, "type": "module",
  "engines": {"node": ">=22"},
  "workspaces": ["packages/*"],
  "scripts": {
    "build:engine": "tsc -b packages/core packages/cli packages/server",
    "build": "npm run build:engine && npm run build:web",
    "build:web": "npm --prefix web run build",
    "test:e2e": "npm --prefix tests run verify",
    "typecheck": "tsc -b packages/core packages/cli packages/server",
    "bridge-cli": "tsx packages/cli/src/index.ts",
    "cli": "tsx packages/cli/src/index.ts",
    "dev:server": "tsx packages/server/src/index.ts",
    "start": "node packages/server/dist/index.js",
    "test:core": "npm run build:engine && tsx --test packages/core/test/*.test.ts packages/server/test/*.test.ts"
  },
  "devDependencies": {"@types/node": "^24.0.0", "@types/yauzl": "^2.10.3", "tsx": "^4.20.6", "typescript": "~5.9.3"}
}
